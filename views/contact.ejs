</div>

<header>
  <%- include('partials/header', { subtitulo: 'Contact Us' }) %>
</header>

<div class="opening-times">
  <strong>Opening Times:</strong> Open every day from 9:00am to 6:00pm. 
  <span id="live-time" class="live-time"></span>
</div> 

<section>
 <div class="destaque">
  <img src="/res/imagens/picture2.png" alt="Animals" class="imagem-destaque">
    <div class="destaque1">
      <h1>Contact us</h1>
      <p>Have a question about Aquarium World, our exhibits, or accessibility? Use the form below to contact us.</p>
    </div>
</div>

        <form action="/contact" method="POST" id="contactForm" novalidate>

          <label for="name">Your Name<span class="required">*</span></label>
          <input type="text" id="name" name="name">
          
          <label for="email">Email Address<span class="required">*</span></label>
          <input type="email" id="email" name="email">

          <label for="subject">Subject<span class="required">*</span></label>
          <input type="text" id="subject" name="subject">

          <label for="message">Message<span class="required">*</span></label>
          <textarea id="message" name="message"></textarea>
          <button type="submit">Send Message</button>

        </form>

</section>

<%- include('partials/footer') %> 

<script src="/scripts/main.js"></script>



</body>
</html>
